# Configurazione per hosting Apache (Aruba)
RewriteEngine On

# Forza HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Fallback SPA: le route gestite da react-router (/project, /about...) tornano index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Cache: index.html va sempre ricontrollato (punta ai file della build corrente),
# i file in assets/ hanno un nome nuovo a ogni build e possono restare in cache a lungo
<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
